{
  "name": "@pasteltech/pastel-ts-coding-standard",
  "version": "0.1.0",
  "private": true,
  "author": "Pastel Tech <info@pastel.com.hk>",
  "license": "MIT",
  "repository": "pastelhk/pastel-ts-coding-standard.git",
  "homepage": "https://github.com/pastelhk/pastel-ts-coding-standard#readme",
  "bugs": "https://github.com/pastelhk/pastel-ts-coding-standard/issues",
  "workspaces": [
    "libs/*",
    "packages/*"
  ],
  "scripts": {
    "audit:eslint-rules": "eslint-find-rules packages/eslint-config-base/recommended.mjs --unused",
    "build": "npm run -ws --if-present prepare",
    "changeset": "changeset",
    "check:format": "prettier -c .",
    "check:lint": "npm run check:lint --workspaces --if-present",
    "check:packages": "syncpack lint",
    "check:test": "npm run check:test --workspaces --if-present",
    "check:types": "npm run check:types --workspaces --if-present",
    "clean": "npm run clean --workspaces",
    "fix:format": "prettier --write .",
    "fix:packages": "syncpack format && syncpack fix",
    "lint": "npm run lint --workspaces --if-present",
    "postinstall": "patch-package",
    "postversion": "npm run postversion --workspaces --if-present",
    "publish": "changeset publish",
    "version": "changeset version && npm install --package-lock-only"
  },
  "prettier": "@pasteltech/prettierrc",
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "eslint-find-rules": "^5.0.0",
    "next": "^15.5.25",
    "patch-package": "^8.0.1",
    "prettier": "^3.6.2",
    "syncpack": "^14.2.1",
    "typescript": "^5.9.2"
  }
}
