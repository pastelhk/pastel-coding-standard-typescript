{
  "$schema": "./node_modules/syncpack/schema.json",
  "indent": "  ",
  "source": ["package.json", "packages/*/package.json", "libs/*/package.json"],
  "sortFirst": [
    "name",
    "version",
    "description",
    "keywords",
    "type",
    "private",
    "author",
    "license",
    "engines",
    "repository",
    "homepage",
    "bugs",
    "workspaces",
    "scripts",
    "exports",
    "main",
    "module",
    "browser",
    "types",
    "bin",
    "sideEffects",
    "files",
    "eslintConfig",
    "prettier",
    "dependencies",
    "peerDependencies",
    "peerDependenciesMeta",
    "optionalDependencies",
    "devDependencies",
    "overrides"
  ],
  "sortAz": [
    "scripts",
    "keywords",
    "contributors",
    "dependencies",
    "peerDependencies",
    "peerDependenciesMeta",
    "optionalDependencies",
    "devDependencies",
    "overrides"
  ],
  "semverGroups": [
    {
      "label": "Local workspace packages should use exact version",
      "dependencies": ["$LOCAL"],
      "range": "",
      "specifierTypes": ["exact"]
    },
    {
      "label": "Use caret ranges for dependencies",
      "dependencies": ["**"],
      "dependencyTypes": ["prod", "dev"],
      "range": "^"
    }
  ],
  "versionGroups": [
    {
      "dependencies": ["@types/**"],
      "dependencyTypes": ["!dev"],
      "isBanned": true,
      "label": "@types packages should only be under devDependencies"
    },
    {
      "label": "Local workspace packages",
      "dependencies": ["$LOCAL"]
    },
    {
      "label": "Align peerDependencies with each other",
      "dependencies": ["**"],
      "dependencyTypes": ["peer"],
      "policy": "sameRange"
    },
    {
      "label": "Align dependencies with each other",
      "dependencies": ["**"],
      "dependencyTypes": ["prod", "dev"]
    }
  ]
}
