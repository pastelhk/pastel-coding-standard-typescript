{
  "extends": "@pasteltech/tsconfig-base",
  "compilerOptions": {
    // node16 + node16 must be paired; output is CJS when package.json omits "type" or sets "type": "commonjs"
    "module": "node16",
    "moduleResolution": "node16",
    // verbatimModuleSyntax is incompatible with commonjs
    "verbatimModuleSyntax": false
  }
}
