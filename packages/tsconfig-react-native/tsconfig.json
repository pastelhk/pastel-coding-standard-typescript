{
  "extends": "@pasteltech/tsconfig-base",
  "compilerOptions": {
    "jsx": "react-native",
    "lib": ["es2023"],

    "module": "esnext",
    "moduleResolution": "bundler",

    "types": ["react-native"],
    "customConditions": ["react-native"],

    "resolvePackageJsonImports": false,
    "allowArbitraryExtensions": true
  }
}
